<Window x:Class="LocalEnvManager.Views.ParameterHelpView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:LocalEnvManager.ViewModels"
        mc:Ignorable="d"
        Title="Parameter Help"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="560"
        MinWidth="460"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=vm:ParameterHelpViewModel, IsDesignTimeCreatable=False}">
    <Border Background="{StaticResource CardSurfaceBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            Padding="0"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource HeroGradientBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            cal:Message.Attach="[Event Click] = [Action Close]"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE106;"
                            FontFamily="Segoe MDL2 Assets"
                            VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="20" Height="20"
                                                 Foreground="White" VerticalAlignment="Center" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Text="{Binding Title}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,8">
                <TextBlock Text="说明"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,6" />
                <TextBlock FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Text="{Binding Description}" />

                <!-- Plain example mode -->
                <StackPanel Visibility="{Binding HasExamples, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                    <TextBlock Text="示例"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,16,0,6" />
                    <Border Background="{StaticResource InputSurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <TextBlock FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="{Binding PlainExample}" />
                    </Border>
                </StackPanel>

                <!-- Clickable examples mode -->
                <StackPanel Visibility="{Binding HasExamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="示例（点击「复制」写入剪贴板）"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding Examples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputSurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Value}"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,10,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AddTextButtonStyle}"
                                                cal:Message.Attach="[Event Click] = [Action CopyExample($dataContext)]"
                                                ToolTip="复制到剪贴板"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="复制" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Padding="24,8,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            cal:Message.Attach="[Event Click] = [Action Close]"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            MinWidth="100" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>