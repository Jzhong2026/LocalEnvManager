<UserControl x:Class="LocalEnvManager.Views.ManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LocalEnvManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ManageViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Left column: Categories list -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Style="{StaticResource CategoryCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Category header -->
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource DeleteIconButtonStyle}"
                                                cal:Message.Attach="RemoveCategory($dataContext)"
                                                ToolTip="删除分类"
                                                Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" />
                                        </Button>
                                        <TextBlock Style="{StaticResource CategoryHeaderStyle}"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                    </DockPanel>

                                    <!-- Project sub-list (configuration only) -->
                                    <ItemsControl ItemsSource="{Binding Projects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SelectableProjectRowStyle}"
                                                        cal:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        cal:Message.Attach="[Event MouseLeftButtonUp] = [Action SelectProject($dataContext)]">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource SelectableRowAccentStyle}" />
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource ProjectAvatarStyle}"
                                                                Margin="8,0,10,0"
                                                                Background="{Binding DeploymentModeAccentBrush}">
                                                            <materialDesign:PackIcon Kind="{Binding DeploymentModeIconKind}"
                                                                                     Width="16" Height="16"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"
                                                                                     Foreground="White" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11"
                                                                       Margin="0,3,0,0"
                                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding DeploymentModeShortLabel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add project -->
                                    <Button Style="{StaticResource AddTextButtonStyle}"
                                            cal:Message.Attach="[Event Click] = [Action AddProject($dataContext)]"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Text="添加项目" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add category -->
                <Button Style="{StaticResource AddTextButtonStyle}"
                        cal:Message.Attach="[Event Click] = [Action AddCategory]"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="添加分类" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Right column: Project detail (configuration only) -->
        <materialDesign:Card Grid.Column="2" Style="{StaticResource CategoryCardStyle}" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DeleteIconButtonStyle}"
                                cal:Message.Attach="[Event Click] = [Action RemoveSelectedProject]"
                                IsEnabled="{Binding HasSelectedProject}"
                                Margin="0,0,8,0"
                                ToolTip="删除项目">
                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" />
                        </Button>
                        <Button cal:Message.Attach="[Event Click] = [Action EditProject]"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                IsEnabled="{Binding HasSelectedProject}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="编辑" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CategoryHeaderStyle}"
                                   Text="{Binding SelectedProject.Name, FallbackValue='请选择项目', TargetNullValue='请选择项目'}" />
                        <Border Style="{StaticResource ModeChipStyle}" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding SelectedProject.DeploymentModeIconKind, FallbackValue=CogOutline, TargetNullValue=CogOutline}"
                                                         Width="13" Height="13"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryDarkBrush}" />
                                <TextBlock FontSize="11"
                                           Margin="5,0,0,0"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           Text="{Binding SelectedProject.DeploymentModeShortLabel, FallbackValue='', TargetNullValue=''}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="项目路径"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding SelectedProject.ProjectPathDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Command"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding SelectedProject.DeploymentModeIconKind, FallbackValue=CogOutline, TargetNullValue=CogOutline}"
                                                         Width="12" Height="12"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryDarkBrush}" />
                                <TextBlock FontSize="11"
                                           Margin="5,0,0,0"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           Text="{Binding SelectedProject.DeploymentModeShortLabel, FallbackValue='', TargetNullValue=''}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SelectedProject.CommandDetailValue, FallbackValue='—', TargetNullValue='—'}"
                                   Style="{StaticResource ProjectDetailValueStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="备份目录"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding SelectedProject.BackupFolderDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="目标路径"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding SelectedProject.TargetPathDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Logs 目录"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding SelectedProject.ResolvedLogsDirectoryDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Git Pull"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding SelectedProject.PullLatestDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Depends On"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="{Binding SelectedProject.DependsOnDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="IIS AppPool"
                               Style="{StaticResource ProjectDetailLabelStyle}" VerticalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="7" Grid.Column="1"
                               Text="{Binding SelectedProject.IisAppPoolNameDisplay, FallbackValue='—', TargetNullValue='—'}"
                               Style="{StaticResource ProjectDetailValueStyle}" Margin="0,12,0,0" />
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
