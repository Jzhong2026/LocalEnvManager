<UserControl x:Class="LocalEnvManager.Views.RunLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LocalEnvManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RunLogsViewModel, IsDesignTimeCreatable=False}">
    <materialDesign:Card Style="{StaticResource CategoryCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource AddTextButtonStyle}"
                        cal:Message.Attach="[Event Click] = [Action ClearLog]">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="清空日志" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource CategoryHeaderStyle}" Text="更新日志" />
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="每个项目一个标签页，查看该项目的完整执行日志。" />
            </DockPanel>

            <TabControl Grid.Row="1"
                        ItemsSource="{Binding ProjectLogs}"
                        SelectedItem="{Binding ActiveLogTab, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProjectName}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    Background="{Binding StateBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StateText}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                            <ScrollViewer Style="{StaticResource DarkLogScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           Text="{Binding TimestampText}" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding LevelText}" />
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="#E2E8F0"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Message}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </materialDesign:Card>
</UserControl>
