<UserControl x:Class="LocalEnvManager.Views.ExecuteView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:behaviors="clr-namespace:LocalEnvManager.Behaviors"
             xmlns:converters="clr-namespace:LocalEnvManager.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LocalEnvManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExecuteViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <converters:GridLengthConverter x:Key="GridLengthConverter" />
    </UserControl.Resources>
    <materialDesign:Card Style="{StaticResource CategoryCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource CategoryHeaderStyle}"
                           Text="执行更新" />
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="{Binding UpdateSummary}" />
            </DockPanel>

            <!-- Two-pane main area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left project-list column: width is bound to the VM so the maximize toggle can collapse it. -->
                    <ColumnDefinition Width="{Binding LeftColumnWidth, Converter={StaticResource GridLengthConverter}}"
                                      MinWidth="0"
                                      x:Name="LeftColumn" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="{Binding RightColumnWidth, Converter={StaticResource GridLengthConverter}}"
                                      MinWidth="280"
                                      x:Name="RightColumn" />
                </Grid.ColumnDefinitions>

                <!-- Left: project table -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Table header -->
                        <Grid Grid.Row="0" Margin="14,12,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                                      IsEnabled="{Binding HasProjects}"
                                      cal:Message.Attach="[Event Click] = [Action ToggleSelectAll]"
                                      ToolTip="勾上即全选；已全选时再点一次则全部取消" />
                            <TextBlock Grid.Column="1" Text="项目" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="模式" Style="{StaticResource TableHeaderStyle}" />
                            <DockPanel Grid.Column="3" LastChildFill="False">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource AddTextButtonStyle}"
                                        cal:Message.Attach="[Event Click] = [Action RefreshBranches]"
                                        IsEnabled="{Binding IsRefreshingBranches, Converter={StaticResource NotConverter}}"
                                        ToolTip="重新拉取每个项目的 git 分支信息"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" />
                                </Button>
                                <TextBlock Text="分支" Style="{StaticResource TableHeaderStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Grid.Column="4" Text="拉取" Style="{StaticResource TableHeaderStyle}" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="6" Text="" Style="{StaticResource TableHeaderStyle}" />
                        </Grid>

                        <!-- Project rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ExecuteProjectRowStyle}"
                                                cal:Action.TargetWithoutContext="{Binding DataContext, ElementName=Root}"
                                                cal:Message.Attach="[Event MouseLeftButtonUp] = [Action SelectProject($dataContext)]">
                                            <Grid Margin="14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <CheckBox VerticalAlignment="Center"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsCheckEnabled}"
                                                              ToolTip="勾选后才会被本次运行更新" />
                                                    <Ellipse Width="10" Height="10"
                                                             Margin="10,0,0,0"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"
                                                             Fill="{Binding LastRunState, Converter={StaticResource ExecutionStateToBrushConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding SourcePath}" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Style="{StaticResource ModeChipStyle}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="{Binding DeploymentModeIconKind}"
                                                                                 Width="12" Height="12"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{StaticResource PrimaryDarkBrush}" />
                                                        <TextBlock FontSize="11"
                                                                   Margin="5,0,0,0"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                                   Text="{Binding DeploymentModeShortLabel}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="3"
                                                        Margin="6,0,6,0"
                                                        Padding="8,3"
                                                        Background="#E2E8F0"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="SourceBranch"
                                                                                 Width="12" Height="12"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#475569" />
                                                        <TextBlock FontSize="11"
                                                                   Margin="5,0,0,0"
                                                                   FontWeight="Medium"
                                                                   Foreground="#334155"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding BranchDisplay}" />
                                                    </StackPanel>
                                                </Border>

                                                <CheckBox Grid.Column="4"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding PullLatest, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsCheckEnabled}"
                                                          ToolTip="执行前先 git pull" />

                                                <Border Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Padding="8,3"
                                                        CornerRadius="4"
                                                        Background="{Binding LastRunState, Converter={StaticResource ExecutionStateToBrushConverter}}">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               Text="{Binding UpdateStateDisplay}" />
                                                </Border>

                                                <!-- Per-row Stop button. Only visible for PowerShell and uvicorn modes
                                                     while running. Dotnet publish / build exit on their own so a stop
                                                     button there would be misleading.
                                                     Routing: cal:Action.Target with ElementName=Root binds to the
                                                     UserControl's named element "Root", whose DataContext is
                                                     ExecuteViewModel. This is the only reliable way inside a nested
                                                     DataTemplate — `Action.TargetWithoutContext` was silently dropping
                                                     the click and the `$parent.$parent` syntax throws ActionNotFound
                                                     (literal method name, not a path). -->
                                                <Button Grid.Column="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        ToolTip="停止进程（uvicorn / PowerShell）"
                                                        Visibility="{Binding IsStopEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        cal:Action.TargetWithoutContext="{Binding DataContext, ElementName=Root}"
                                                        cal:Message.Attach="[Event Click] = [Action StopProject($dataContext)]"
                                                        Background="#DC2626"
                                                        BorderBrush="#DC2626"
                                                        Foreground="White">
                                                    <materialDesign:PackIcon Kind="Stop" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: details card with live log -->
                <materialDesign:Card Grid.Column="2" Style="{StaticResource CategoryCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Detail header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CategoryHeaderStyle}"
                                           Text="{Binding SelectedProject.Name, FallbackValue='请先选择项目', TargetNullValue='请先选择项目'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedProject.SourcePath, FallbackValue='—', TargetNullValue='—'}" />
                            </StackPanel>

                            <!-- Maximize / restore toggle. Publishes a message; ExecuteViewModel
                                 listens for it and toggles the column widths. -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    cal:Message.Attach="[Event Click] = [Action PublishMaximizeToggle]"
                                    ToolTip="放大 / 还原右侧详情"
                                    VerticalAlignment="Center"
                                    MinWidth="80"
                                    Height="32"
                                    Padding="10,0"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{Binding MaximizeIconKind}"
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Text="{Binding MaximizeButtonLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Branch + state row -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="10,6"
                                    Background="#F1F5F9"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SourceBranch"
                                                             Width="14" Height="14"
                                                             VerticalAlignment="Center"
                                                             Foreground="#475569" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="#334155"
                                               Text="{Binding SelectedProject.BranchDisplay, FallbackValue='—', TargetNullValue='—'}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Padding="10,6"
                                    CornerRadius="6"
                                    Background="{Binding SelectedProject.LastRunState, Converter={StaticResource ExecutionStateToBrushConverter}}">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding SelectedProject.UpdateStateDisplay, FallbackValue='未运行', TargetNullValue='未运行'}" />
                            </Border>
                        </Grid>

                        <!-- Right-pane live log -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ContentControl Grid.Row="1" Content="{Binding ActiveLiveLog}">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:ConsoleLiveLogViewModel}">
                                        <Grid>
                                            <Border Background="#0F172A"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Visibility="{Binding Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ScrollViewer Style="{StaticResource DarkLogScrollViewer}"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              behaviors:AutoScrollToEndBehavior.IsEnabled="True">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           Foreground="#E2E8F0"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <Border Background="#F1F5F9"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="14,10"
                                                    Visibility="{Binding Available, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ConsoleLine"
                                                                                 Width="16" Height="16"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#64748B" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#334155"
                                                                   Text="控制台输出" />
                                                    </StackPanel>
                                                    <TextBlock Margin="24,8,0,0"
                                                               FontSize="12"
                                                               Foreground="#64748B"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Hint}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogFileLiveLogViewModel}">
                                        <Grid>
                                            <Border Background="#0F172A"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Visibility="{Binding Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ScrollViewer Style="{StaticResource DarkLogScrollViewer}"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              behaviors:AutoScrollToEndBehavior.IsEnabled="True">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           Foreground="#E2E8F0"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <Border Background="#F1F5F9"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="14,10"
                                                    Visibility="{Binding Available, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                                                 Width="16" Height="16"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#64748B" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#334155"
                                                                   Text="日志文件" />
                                                    </StackPanel>
                                                    <TextBlock Margin="24,8,0,0"
                                                               FontSize="12"
                                                               Foreground="#64748B"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Hint}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Footer action bar -->
            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                cal:Message.Attach="[Event Click] = [Action RunSelected]"
                                IsEnabled="{Binding CanRunSelected}"
                                Visibility="{Binding IsRunning, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                ToolTip="运行所有勾选的项目">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayBoxOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                    <Run Text="运行" FontWeight="SemiBold" FontSize="13" />
                                    <Run Text=" (" FontSize="13" />
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontSize="13" />
                                    <Run Text=")" FontSize="13" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Margin="10,0,0,0"
                                Style="{StaticResource DangerActionButtonStyle}"
                                cal:Message.Attach="[Event Click] = [Action Cancel]"
                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="取消正在执行的运行">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="取消" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="勾选项目后点击右下角的「运行」按钮执行；切换左侧项目即可查看其 logs 目录的最新文件内容。" />
                </DockPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
